generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  password     String
  name         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  projects     Project[]
  chatSessions ChatSession[]
}

model Project {
  id              String   @id @default(uuid())
  name            String
  description     String?
  protocol        String   // HTTP, HTTPS, MQTT, MQTTS, WS, WSS
  host            String
  port            Int?
  endpoint        String?  // For HTTP or WS path
  topic           String?  // For MQTT
  authToken       String?
  headers         String?  // JSON string array of {key, value}
  username        String?
  password        String?
  sslEnabled      Boolean  @default(false)
  autoReconnect   Boolean  @default(true)
  webhookToken    String?  @unique  // Public webhook listener token
  webhookEnabled  Boolean  @default(false)
  status          String   @default("inactive") // active, inactive, error
  lastActivity    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payloads        Payload[]
  logs            Log[]
  simulations     Simulation[]
  alertRules      AlertRule[]
  alertLogs       AlertLog[]
  authConfig      AuthConfig?
}

model Payload {
  id          String   @id @default(uuid())
  name        String
  structure   String   // JSON string of payload structure
  template    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Simulation {
  id              String   @id @default(uuid())
  jobId           String?  @unique // For job manager
  moduleName      String   @default("custom") // hera, drone, carbon, custom
  mode            String   @default("interval") // interval, manual, scenario
  status          String   @default("idle") // idle, running, stopped, error
  interval        Int      @default(5000) // milliseconds
  batchSize       Int      @default(1)
  swarmMode       Boolean  @default(false)
  swarmCount      Int      @default(1)
  stages          String?  // JSON string [{duration, target}]
  targetCount     Int?     // Auto-stop after N sends
  payloadKind     String?  // For modules with multiple kinds
  payloadOptions  String?  // JSON string
  
  // Stats
  totalSent       Int      @default(0)
  successCount    Int      @default(0)
  errorCount      Int      @default(0)
  
  // Tracking
  lastRunAt       DateTime?
  lastPayload     String?  // JSON string
  lastResponse    String?  // JSON string
  lastError       String?
  
  startedAt       DateTime?
  stoppedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  @@index([moduleName, status])
  @@index([projectId, status])
}

model Log {
  id          String   @id @default(uuid())
  type        String   // request, response, error, event
  protocol    String
  message     String
  payload     String?  // JSON string
  statusCode  Int?
  latency     Int?     // milliseconds
  timestamp   DateTime @default(now())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Dataset {
  id                String   @id @default(uuid())
  name              String
  moduleName        String   // hera, drone, carbon
  fileName          String
  filePath          String
  filePathRelative  String?
  fileSizeBytes     BigInt
  checksumSha256    String
  delimiter         String   @default(",")
  loadedRows        Int      @default(0)
  skippedRows       Int      @default(0)
  isActive          Boolean  @default(false)
  lastLoadedAt      DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@unique([moduleName, fileName])
  @@index([moduleName, isActive])
}

model ChatSession {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String        @default("New Conversation")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([userId, updatedAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String      // user, assistant, system
  content   String      @db.Text
  metadata  Json?       // For task execution data
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

model AlertRule {
  id        String   @id @default(uuid())
  name      String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  field     String
  operator  String
  value     String
  severity  String   @default("warning")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AlertLog {
  id        String   @id @default(uuid())
  ruleId    String?
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  message   String
  value     String
  severity  String
  timestamp DateTime @default(now())
  read      Boolean  @default(false)
}

model AuthConfig {
  id              String   @id @default(uuid())
  projectId       String   @unique
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  // Auth Method
  authType        String   // "bearer", "apikey", "custom", "none"
  
  // Token Storage (encrypted)
  token           String?  @db.Text
  tokenExpiry     DateTime?
  
  // Refresh Config
  refreshEnabled  Boolean  @default(false)
  refreshUrl      String?
  refreshMethod   String?  @default("POST") // "POST", "GET"
  refreshBody     Json?
  refreshHeaders  Json?
  refreshTokenPath String? // JSON path to extract token from response
  refreshExpiryPath String? // JSON path to extract expiry from response
  
  // Custom Headers
  customHeaders   Json?    // [{key, value, isDynamic}]
  
  // Header Injection Config
  headerKey       String?  @default("Authorization") // Where to inject token
  headerPrefix    String?  @default("Bearer") // Prefix for token (Bearer, API-Key, etc)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  refreshLogs     RefreshLog[]
  
  @@index([projectId])
}

model RefreshLog {
  id            String     @id @default(uuid())
  authConfigId  String
  authConfig    AuthConfig @relation(fields: [authConfigId], references: [id], onDelete: Cascade)
  
  status        String     // "success", "failed"
  oldTokenHash  String?    // Hash of old token for security
  newTokenHash  String?    // Hash of new token
  errorMessage  String?    @db.Text
  responseTime  Int?       // milliseconds
  
  createdAt     DateTime   @default(now())
  
  @@index([authConfigId, createdAt])
}
