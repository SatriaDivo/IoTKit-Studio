# Server Configuration
NODE_ENV=development
PORT=4000
HOST=localhost

# Database PostgreSQL
DATABASE_URL="postgresql://postgres:123@localhost:5432/iotkit_studio?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting (development: permissive)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=500

# OpenRouter AI
# IMPORTANT: Get your API key from https://openrouter.ai/keys
# NEVER commit this file to git!
OPENROUTER_API_KEY=YOUR_NEW_KEY_HERE
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
