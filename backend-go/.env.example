# Server Configuration
PORT=4000
HOST=localhost

# Database PostgreSQL (DSN format for GORM)
DATABASE_URL=host=localhost user=postgres password=123 dbname=iotkit_studio port=5432 sslmode=disable

# JWT Security (Must be at least 32 characters of high-entropy random data)
JWT_SECRET=generate-a-strong-random-at-least-32-byte-secret-key-here
JWT_EXPIRES_HOURS=168

# CORS Allowed Origin (Frontend URL)
CORS_ORIGIN=http://localhost:3000

# File Upload Configuration
UPLOAD_DIR=./uploads/datasets

# AI Integration (Supports 9router, OpenRouter, or OpenAI-compatible gateways)
AI_BASE_URL=https://9router.stdv.biz.id/v1
AI_API_KEY=your_api_key_here
AI_MODEL=ag/gemini-3.8-flash-high

# Fallback compatibility
OPENROUTER_API_KEY=your_api_key_here
OPENROUTER_MODEL=ag/gemini-3.8-flash-high
